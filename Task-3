<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Advanced Frontend Project</title>

<style>

/* ===== GENERAL STYLING ===== */
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f4f4;
}

h2 {
    text-align: center;
}

/* ===== NAVIGATION ===== */
nav {
    background: #222;
    color: white;
    padding: 15px;
    text-align: center;
}

/* ===== CONTAINER ===== */
.container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 20px;
}

/* ===== CARD STYLE ===== */
.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

/* ===== QUIZ ===== */
.options button {
    display: block;
    margin: 8px 0;
    padding: 8px;
    width: 100%;
}

/* ===== CAROUSEL ===== */
.carousel img {
    width: 100%;
    border-radius: 10px;
}

.carousel-buttons {
    text-align: center;
    margin-top: 10px;
}

/* ===== API SECTION ===== */
#joke {
    margin: 15px 0;
    font-style: italic;
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 900px) {
    .container {
        grid-template-columns: 1fr;
    }

    body {
        font-size: 14px;
    }
}

@media (max-width: 500px) {
    nav {
        font-size: 16px;
    }

    body {
        font-size: 13px;
    }
}

</style>
</head>
<body>

<nav>
    <h1>Advanced Frontend Project</h1>
</nav>

<div class="container">

    <!-- ===== QUIZ SECTION ===== -->
    <div class="card">
        <h2>Interactive Quiz</h2>
        <p id="question"></p>
        <div class="options" id="options"></div>
        <p id="score"></p>
        <button onclick="nextQuestion()">Next</button>
    </div>

    <!-- ===== CAROUSEL SECTION ===== -->
    <div class="card">
        <h2>Image Carousel</h2>
        <div class="carousel">
            <img id="carouselImage" src="https://picsum.photos/400/250?random=1">
        </div>
        <div class="carousel-buttons">
            <button onclick="prevImage()">Previous</button>
            <button onclick="nextImage()">Next</button>
        </div>
    </div>

    <!-- ===== API SECTION ===== -->
    <div class="card" style="grid-column: span 2;">
        <h2>Random Joke Generator (API)</h2>
        <p id="joke">Click button to load joke...</p>
        <button onclick="getJoke()">Get Joke</button>
    </div>

</div>

<script>

/* ================= QUIZ LOGIC ================= */

const questions = [
    {
        question: "What does HTML stand for?",
        options: ["Hyper Trainer Marking Language", "Hyper Text Markup Language", "High Text Machine Language"],
        answer: 1
    },
    {
        question: "Which CSS property controls layout?",
        options: ["color", "display", "font-size"],
        answer: 1
    },
    {
        question: "Which method is used to fetch API data?",
        options: ["getData()", "fetch()", "loadAPI()"],
        answer: 1
    }
];

let currentQuestion = 0;
let score = 0;

function loadQuestion() {
    const q = questions[currentQuestion];
    document.getElementById("question").innerText = q.question;
    const optionsDiv = document.getElementById("options");
    optionsDiv.innerHTML = "";

    q.options.forEach((option, index) => {
        const btn = document.createElement("button");
        btn.innerText = option;
        btn.onclick = function() {
            if(index === q.answer) {
                score++;
                alert("Correct!");
            } else {
                alert("Wrong!");
            }
        };
        optionsDiv.appendChild(btn);
    });
}

function nextQuestion() {
    currentQuestion++;
    if(currentQuestion < questions.length) {
        loadQuestion();
    } else {
        document.getElementById("question").innerText = "Quiz Finished!";
        document.getElementById("options").innerHTML = "";
        document.getElementById("score").innerText = "Your Score: " + score;
    }
}

loadQuestion();

/* ================= CAROUSEL LOGIC ================= */

let imageIndex = 1;

function nextImage() {
    imageIndex++;
    document.getElementById("carouselImage").src =
        "https://picsum.photos/400/250?random=" + imageIndex;
}

function prevImage() {
    if(imageIndex > 1) {
        imageIndex--;
    }
    document.getElementById("carouselImage").src =
        "https://picsum.photos/400/250?random=" + imageIndex;
}

/* ================= API FETCH ================= */

async function getJoke() {
    try {
        const response = await fetch("https://api.chucknorris.io/jokes/random");
        const data = await response.json();
        document.getElementById("joke").innerText = data.value;
    } catch(error) {
        document.getElementById("joke").innerText = "Failed to load joke.";
    }
}

</script>

</body>
</html>
